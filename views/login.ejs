<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="css/login.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Afacad+Flux">

    <title>Buzz - Login</title>
</head>

<body>
    <h1>Welcome to our quiz app!</h1>
    <div class="container-sm">
        <h2>Login here:</h2>
        <% if (error) { %>
            <p style="color: red;"><%= error %></p>
          <% } %>
        <div class="form">
            <form method="post" action="/login">
                <div class="form-group">
                    <label for="Username">Username</label><br>
                    <input name="username" type="text" style="max-width: fit-content;" class="form-control"
                        id="Username" placeholder="Username">
                </div>
                <div class="form-group">
                    <label for="Password">Password</label><br>
                    <input name="password" type="password" style="max-width:fit-content;" class="form-control"
                        id="Password" placeholder="Password">
                </div>
                <button type="submit" class="mybtn btn btn-primary">Login</button>
            </form>
        </div>
        <footer>Don't have an account? <a href="/register">Sign up</a> now!</footer>
    </div>
</body>

</html>