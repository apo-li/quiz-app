<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Syne"> -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Afacad+Flux">

    <link rel="stylesheet" href="css/home.css">
    <title>Buzz - Welcome</title>
</head>

<body>
    <h1>Welcome to our quiz app!</h1>
    <div class="container-sm">
        <h2>Join a game now!</h2>
        <div class="form">
            <form>
                <div class="form-group">
                    <label for="Your Name">Your Name</label><br>
                    <input name = "yourName" type="text" style="max-width: fit-content;" class="form-control" id="Your Name"
                        placeholder="Your Name">
                </div>
                <div class="form-group">
                    <label for="Game PIN">Game PIN</label><br>
                    <input name="gamePIN" type="number" style="max-width:fit-content;" class="form-control" id="Game PIN"
                        placeholder="Game PIN">
                </div>
            <button type="submit" class="mybtn btn btn-primary">Join</button>
            </form>
        </div>
        <footer> ...or <a href="/login">login</a> to create your own quiz!</footer>
    </div>
    <br><br>
</body>

</html>