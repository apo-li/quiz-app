<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Manrope">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
    <link rel="stylesheet" href="/css/create.css">
    <title>Create Quiz - Add Questions</title>
</head>

<body>
    <h2>Create Quiz</h2>
    <form id="quizForm" method="POST" action="/add-questions/<%=quizId%>">
        <div class="container-sm qstn form ">

            <label for="question-1">Question 1:</label>
            <textarea type="text" id="question-1" name="question-1" class="qbox form-control" required></textarea>

            <div class="options">
                <p>
                    <label for="option-1-1">Option 1:</label>
                    <input type="text" id="option-1-1" name="option-1-1" value="" class="form-control"
                        oninput="updateCorrectDropdown(0)" required>
                </p>
                <p>
                    <label for="option-1-2">Option 2:</label>
                    <input type="text" id="option-1-2" name="option-1-2" value="" class="form-control"
                        oninput="updateCorrectDropdown(0)" required>
                </p>
                <p>
                    <label for="option-1-3">Option 3:</label>
                    <input type="text" id="option-1-3" name="option-1-3" value="" class="form-control"
                        oninput="updateCorrectDropdown(0)" required>
                </p>
                <p>
                    <label for="option-1-4">Option 4:</label>
                    <input type="text" id="option-1-4" name="option-1-4" value="" class="form-control"
                        oninput="updateCorrectDropdown(0)" required>
                </p>
                <p>
                    <label for="right-answer-1">Right Answer:</label>
                    <select id="right-answer-1" name="right-answer-1" class="form-control" required>
                        <option value="">Select correct option</option>
                        <option value=""></option>
                        <option value=""></option>
                        <option value=""></option>
                        <option value=""></option>
                    </select>
                </p>
            </div>
        </div>
        <div class="buttons">
            <button type="button" class="mybtn btn btn-primary" onclick="addQuestion()">Add Question</button>
            <button type="submit" class="mybtn btn btn-primary">Submit</button>
        </div>
    </form>
    <br>

    <script src="/js/createFront.js"></script>
</body>

</html>